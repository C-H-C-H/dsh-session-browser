{
  "name": "dsh-session-browser",
  "version": "4.1.0",
  "description": "DSH Desktop plugin for browsing sessions with round-level navigation and message jumping",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "keywords": [
    "dsh",
    "dsh-desktop",
    "plugin",
    "session-browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/C-H-C-H/dsh-session-browser.git"
  }
}
